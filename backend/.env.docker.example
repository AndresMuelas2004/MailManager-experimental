DATABASE_URL=postgresql://<user>:<pass>@postgres:5432/<db>
MIA_GMAIL_CREDENTIALS_PATH=/secrets/gmail_credentials.json
MIA_OUTLOOK_CREDENTIALS_PATH=/secrets/outlook_credentials.json
GOOGLE_CLIENT_ID=
DB_AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
TOKEN_PLAINTEXT_FALLBACK_ENABLED=true
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1
# Dev-only login backdoor (local development ONLY — never enable in production).
# When DEV_LOGIN_ENABLED is truthy (1/true/yes/on), POST /auth/dev-login mints a
# session for DEV_LOGIN_EMAIL without OAuth. The request must originate from a
# host listed in DEV_LOGIN_TRUSTED_HOSTS; under Podman the browser reaches
# uvicorn from the network gateway (10.89.42.1), not 127.0.0.1.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMAIL=
DEV_LOGIN_TRUSTED_HOSTS=10.89.42.1,127.0.0.1,::1,localhost
