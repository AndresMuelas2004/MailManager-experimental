DATABASE_URL=postgresql://<user>:<pass>@postgres:5432/<db>
MIA_GMAIL_CREDENTIALS_PATH=/secrets/gmail_credentials.json
MIA_OUTLOOK_CREDENTIALS_PATH=/secrets/outlook_credentials.json
GOOGLE_CLIENT_ID=
DB_AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
TOKEN_PLAINTEXT_FALLBACK_ENABLED=true
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1
# Dev-only login backdoor (local development ONLY — never enable in production).
# When DEV_LOGIN_ENABLED is truthy (1/true/yes/on), POST /auth/dev-login mints a
# session for DEV_LOGIN_EMAIL without OAuth. The request must originate from a
# host listed in DEV_LOGIN_TRUSTED_HOSTS. Under Podman rootless the published
# port is SNAT'd to the backend container's OWN IP in the compose subnet
# (10.89.42.0/24) — empirically .5, NOT the .1 gateway — and that IP can shift
# when the container is recreated, so trust the low range of the subnet.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMAIL=
DEV_LOGIN_TRUSTED_HOSTS=10.89.42.1,10.89.42.2,10.89.42.3,10.89.42.4,10.89.42.5,10.89.42.6,10.89.42.7,10.89.42.8,10.89.42.9,10.89.42.10,127.0.0.1,::1,localhost
