DATABASE_URL=
DB_POOL_MIN_CONN=1
# Must cover the parallel background backfill: >= BACKFILL_DB_WRITE_CONCURRENCY
# + headroom for user requests. PostgreSQL max_connections (default 100) admits it.
DB_POOL_MAX_CONN=25
DB_CONNECT_TIMEOUT_SECONDS=10
DB_APPLICATION_NAME=mailmanager-api
DB_AUTO_MIGRATE=false
DB_SEED_TEST_DATA=true
DB_ALEMBIC_INI_PATH=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1
TOKEN_PLAINTEXT_FALLBACK_ENABLED=true
MIA_GMAIL_CREDENTIALS_PATH=
MIA_OUTLOOK_CREDENTIALS_PATH=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=
AUTH_SESSION_LIFETIME_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=
# Per-user connected-account limit (create_account guard + GET /accounts/quota).
MAX_ACCOUNTS_PER_USER=15
# Background backfill + draft-sync worker tuning (all optional; defaults shown).
# Accounts downloaded in parallel; keep DB_POOL_MAX_CONN >= *_DB_WRITE_CONCURRENCY + reserve.
BACKFILL_MAX_CONCURRENT=15
BACKFILL_DB_WRITE_CONCURRENCY=8
# Auto-retry budget for a failed backfill/draft-sync job before it stays failed.
BACKFILL_MAX_ATTEMPTS=5
# Remote-email-image proxy. HMAC key for the signed sentinel URLs baked into the
# cached HTML — leave empty in dev (a fixed insecure fallback key is used).
# PROD MUST set a strong, persistent value (a change invalidates every already
# cached signed URL). Also load-bearing because /image-proxy is rate-limit-exempt.
IMAGE_PROXY_SIGNING_KEY=
# Token for POST /admin/image-proxy/purge (X-Admin-Token). Unset → endpoint 503.
IMAGE_PROXY_PURGE_TOKEN=
