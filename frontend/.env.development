# Loaded only by the Vite dev server (mode=development), never by the
# production build (mode=production) nor by Vitest (mode=test). The latter
# is what keeps LoginPage.test.tsx exercising the manual Dev login button
# instead of auto-logging-in.
#
# Auto-login through the backend dev-login backdoor so the login screen is
# skipped during local development. Also gated in code by import.meta.env.DEV.
# Requires DEV_LOGIN_ENABLED=true + a valid DEV_LOGIN_EMAIL in backend/.env.docker.
VITE_DEV_AUTO_LOGIN=true
