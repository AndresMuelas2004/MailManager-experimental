# .env.production.example — template for the PRODUCTION environment.
#
# On the VPS, copy this file to `.env.production`, fill in the real values and
# protect it with `chmod 600 .env.production`. NEVER commit the real file
# (.gitignore ignores .env.production; only this .example is tracked).
#
# Start the stack with:
#   docker compose --env-file .env.production -f compose.prod.yml up -d --build
#
# This single file serves two roles:
#   1) compose interpolation (via --env-file): DOMAIN, ACME_EMAIL, SECRETS_DIR,
#      POSTGRES_PASSWORD, VITE_API_BASE_URL, VITE_GOOGLE_CLIENT_ID,
#      VITE_MICROSOFT_CLIENT_ID.
#   2) backend runtime env (via the backend service's env_file): the rest.

# --- Domain & TLS (Caddy) ---
DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Frontend (build-time; baked into the bundle by `vite build`) ---
# Same domain behind proxy: the API lives under /api.
VITE_API_BASE_URL=https://example.com/api
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
# Azure App Registration SPA "Application (client) ID" for Microsoft user login.
# Optional: leave empty to bake a disabled "Continue with Microsoft" button.
# Must match the backend's MICROSOFT_CLIENT_ID below.
VITE_MICROSOFT_CLIENT_ID=<your-azure-app-client-id>

# --- Mounted secrets (#10) ---
# A directory on the VPS holding ONLY the 2 credential JSON files
# (gmail_credentials.json, outlook_credentials.json). Do NOT point this at the
# dev folder that also contains the SQL dump.
# H4: the prod backend runs as a non-root user (UID 10001), so the 2 JSON files
# must be readable by it — `chmod 644` the files. The dir itself must be traversable by UID 10001:
# `chmod 711` it (a `700` dir blocks the non-root backend from reaching the
# files even when they are `644`).
# Root containers read them regardless; the non-root one does not. If you skip
# this, the backend still boots and /health stays 200, but the FIRST account
# connect / sync fails with CredentialReadError (the JSON is read lazily, not at
# startup).
SECRETS_DIR=/opt/mailmanager/secrets

# --- Database ---
POSTGRES_PASSWORD=<strong-password>
# DATABASE_URL must carry the SAME strong password and the internal host `postgres`.
DATABASE_URL=postgresql://mailmanager:<strong-password>@postgres:5432/mailmanager

# --- Token encryption (#1) ---
# GENERATE A NEW KEY ON THE VPS (different from dev). NEVER reuse the dev key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<production-fernet-key>
TOKEN_ENCRYPTION_KEY_ID=v1
# Fail-closed in prod: no plaintext fallback.
TOKEN_PLAINTEXT_FALLBACK_ENABLED=false

# --- OAuth ---
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
# Must match the redirect URI registered in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=https://example.com/api/auth/google/callback
# Microsoft user login (OIDC). The Application (client) ID of the Azure app
# registration whose SPA platform the frontend uses. The backend only verifies
# the id_token (no backend redirect URI / no token exchange), so there is no
# MICROSOFT_OAUTH_REDIRECT_URI here. Leave empty to disable the "Continue with
# Microsoft" button server-side. Must match the frontend's VITE_MICROSOFT_CLIENT_ID.
MICROSOFT_CLIENT_ID=<your-azure-app-client-id>
# (Outlook: its redirect_uri lives in outlook_credentials.json and must be
#  registered in Azure as https://example.com/api/auth/outlook/callback)
MIA_GMAIL_CREDENTIALS_PATH=/secrets/gmail_credentials.json
MIA_OUTLOOK_CREDENTIALS_PATH=/secrets/outlook_credentials.json

# --- Session / cookies (#4 / #8) ---
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# --- CORS / frontend origin (same domain) ---
# The first value is also used as the postMessage target_origin of the OAuth callback.
CORS_ALLOWED_ORIGINS=https://example.com

# --- Rate limiting (#11e) ---
# Per-client request throttling (login, send, provider syncs + a global per-IP
# safety net). Opt-in: OFF unless explicitly truthy (1/true/yes/on). Enable it
# in production. State is in-process memory (single worker); lost on restart.
RATE_LIMIT_ENABLED=true

# --- Migrations ---
# The schema is built at startup (auto-migrate). The test-data seed (#11d) is
# turned OFF in production: the app must not boot with a phantom user or made-up
# emails. In dev/test the default is ON, so only production sets it false.
DB_AUTO_MIGRATE=true
DB_SEED_TEST_DATA=false

# --- Background backfill / draft-sync worker & account limit ---
# All optional (sensible defaults shown). The in-process worker downloads each
# newly connected account's history in parallel and syncs its drafts.
# INVARIANT: DB_POOL_MAX_CONN must be >= BACKFILL_DB_WRITE_CONCURRENCY plus
# headroom for user requests, or the parallel backfill starves the pool
# (psycopg2 getconn() RAISES on exhaustion). Default DB_POOL_MAX_CONN is 25.
# DB_POOL_MAX_CONN=25
BACKFILL_MAX_CONCURRENT=15
BACKFILL_DB_WRITE_CONCURRENCY=8
BACKFILL_MAX_ATTEMPTS=5
# Per-user connected-account limit (create_account guard + GET /accounts/quota).
MAX_ACCOUNTS_PER_USER=15
